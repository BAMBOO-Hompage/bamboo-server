# ============================================
# BAMBOO 프로젝트 환경 변수 설정
# ============================================
# 사용법: 이 파일을 .env로 복사한 후 사용하세요
# 명령어: copy env.template .env
# ============================================

# ============================================
# 데이터베이스 설정 (Docker MySQL)
# ============================================
DB_USERNAME=bamboo_user
DB_PASSWORD=bamboo_password
DB_URL=jdbc:mysql://localhost:3306/bamboo_db?useSSL=false&serverTimezone=Asia/Seoul&characterEncoding=UTF-8&allowPublicKeyRetrieval=true

# ============================================
# Redis 설정 (Docker Redis - 비밀번호 없음)
# ============================================
REDIS_HOST=localhost
REDIS_PASSWORD=

# ============================================
# 이메일 설정 (로컬 개발용)
# ============================================
# 실제 이메일 기능을 사용하려면 Gmail 앱 비밀번호를 설정하세요
# https://myaccount.google.com/apppasswords
MAIL_SENDER=test@bamboo.com
MAIL_PASSWORD=test1234
MAIL_AUTH_CODE_EXPIRATION=600000

# ============================================
# JWT 설정 (개발 환경용)
# ============================================
JWT_SECRET=bamboo_super_secret_jwt_key_for_development_environment_must_be_at_least_256_bits_long_string_12345678
ACCESS_EXPIRATION_TIME=3600000
REFRESH_EXPIRATION_TIME=86400000

# ============================================
# AWS S3 설정 (로컬 개발용 더미값)
# ============================================
# 파일 업로드 기능을 사용하지 않는다면 이대로 두세요
# 실제로 S3를 사용하려면 AWS 콘솔에서 발급받은 키를 입력하세요
S3_ACCESS_KEY=dummy_access_key
S3_SECRET_KEY=dummy_secret_key
S3_BUCKET_NAME=dummy-bucket

